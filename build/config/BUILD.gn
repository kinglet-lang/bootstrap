import("//build/fuzz.gni")

declare_args() {
  is_debug = true
  sanitizer = ""
  coverage = false
}

config("compiler") {
  cflags_cc = [
    "-std=c++20",
  ]

  if (!is_debug) {
    cflags = [ "-O2" ]
    defines = [ "NDEBUG" ]
  } else {
    cflags = [ "-g" ]
    defines = []
  }
}

config("warnings") {
  cflags = [
    "-Wall",
    "-Wextra",
    "-Wpedantic",
  ]

  cflags_cc = [
    "-Wconversion",
    "-Wsign-conversion",
  ]
}

config("sanitizer") {
  if (sanitizer != "") {
    cflags = [
      "-fsanitize=$sanitizer",
      "-fno-omit-frame-pointer",
    ]
    ldflags = [ "-fsanitize=$sanitizer" ]
  }
}

# Applied to every default-config'd target so the whole compiler carries
# libFuzzer coverage instrumentation. "no-link" means these object files are
# instrumented but do not pull in the libFuzzer main(); only the fuzz target
# executables (via the "fuzzer" config below) link the driver.
config("fuzzer_instrumentation") {
  if (use_libfuzzer) {
    cflags = [
      "-fsanitize=fuzzer-no-link",
      "-fno-omit-frame-pointer",
    ]
  }
}

# Applied only to fuzz target executables. Links the libFuzzer driver (which
# supplies main()) against the instrumented compiler libraries.
config("fuzzer") {
  cflags = [ "-fsanitize=fuzzer" ]
  ldflags = [ "-fsanitize=fuzzer" ]
}

config("coverage") {
  if (coverage) {
    cflags = [
      "-fprofile-instr-generate",
      "-fcoverage-mapping",
    ]
    ldflags = [ "-fprofile-instr-generate" ]
  }
}
