# Optional LLVM integration for the native backend (ADR 0015 L0).
#
# Enable:
#   gn gen out/Default --args='enable_llvm=true llvm_config="/path/to/llvm-config"'
# or set LLVM_CONFIG in the environment and omit llvm_config.

declare_args() {
  enable_llvm = false
  llvm_config = ""
  # When true, pass --link-static to llvm-config --libs so the linker gets
  # individual .a archives instead of a monolithic shared library.  With LTO
  # and dead-code elimination, unreferenced code is dropped — shrinking the
  # binary from ~45 MB (dynamic) to ~15 MB or less.
  llvm_link_static = false
}

llvm_config_bin = ""
llvm_cxxflags = []
llvm_ldflags = []
llvm_libs = []

if (enable_llvm) {
  llvm_config_bin = llvm_config
  if (llvm_config_bin == "") {
    llvm_config_bin = exec_script("//build/scripts/find_llvm_config.py", [], "trim string")
  }

  _cxxflags_args = [ llvm_config_bin, "cxxflags" ]
  llvm_cxxflags = exec_script("//build/scripts/llvm_config.py",
                              _cxxflags_args,
                              "list lines")

  _ldflags_args = [ llvm_config_bin ]
  if (llvm_link_static) {
    _ldflags_args += [ "--link-static" ]
  }
  _ldflags_args += [ "ldflags" ]
  llvm_ldflags = exec_script("//build/scripts/llvm_config.py",
                              _ldflags_args,
                              "list lines")

  # System libraries from llvm-config --system-libs.  These must appear
  # AFTER the LLVM .a archives for static linking — the linker resolves
  # left-to-right and the .a files have forward references to system
  # symbols.
  _system_libs = []
  _syslibs_args = [ llvm_config_bin ]
  if (llvm_link_static) {
    _syslibs_args += [ "--link-static" ]
  }
  _syslibs_args += [ "systemlibs" ]
  _system_libs = exec_script("//build/scripts/llvm_config.py",
                              _syslibs_args,
                              "list lines")

  # Dead-code elimination: drop unreferenced sections from LLVM static
  # archives.  Paired with -ffunction-sections -fdata-sections during the
  # LLVM build, this strips out ~70% of the .a content at link time.
  _extra_llvm_libs = []
  if (llvm_link_static) {
    if (host_os == "mac") {
      llvm_ldflags += [
        "-Wl,-dead_strip",
        "-Wl,-S",
      ]
    } else {
      llvm_ldflags += [
        "-Wl,--gc-sections",
        "-Wl,-s",
      ]
    }
    # System libraries go AFTER LLVM .a archives.  The self-built LLVM
    # is configured with -DLLVM_ENABLE_ZLIB=OFF and -DLLVM_ENABLE_ZSTD=OFF,
    # so z / zstd are intentionally absent.
    _extra_llvm_libs += _system_libs
  }

  _libs_args = [ llvm_config_bin ]
  if (llvm_link_static) {
    _libs_args += [ "--link-static" ]
  }
  _libs_args += [ "libs" ]
  llvm_libs = exec_script("//build/scripts/llvm_config.py",
                          _libs_args,
                          "list lines") + _extra_llvm_libs
}
