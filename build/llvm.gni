# Optional LLVM integration for the native backend (ADR 0015 L0).
#
# Enable:
#   gn gen out/Default --args='enable_llvm=true llvm_config="/path/to/llvm-config"'
# or set LLVM_CONFIG in the environment and omit llvm_config.

declare_args() {
  enable_llvm = false
  llvm_config = ""
  # When true, pass --link-static to llvm-config --libs so the linker gets
  # individual .a archives instead of a monolithic shared library.  With LTO
  # and --gc-sections, dead code is dropped — useful on Windows where bundling
  # the full libLLVM.dll balloons the release archive to ~45 MB.
  llvm_link_static = false
}

llvm_config_bin = ""
llvm_cxxflags = []
llvm_ldflags = []
llvm_libs = []

if (enable_llvm) {
  llvm_config_bin = llvm_config
  if (llvm_config_bin == "") {
    llvm_config_bin = exec_script("//build/scripts/find_llvm_config.py", [], "trim string")
  }

  _cxxflags_args = [ llvm_config_bin, "cxxflags" ]
  llvm_cxxflags = exec_script("//build/scripts/llvm_config.py",
                              _cxxflags_args,
                              "list lines")

  _ldflags_args = [ llvm_config_bin ]
  if (llvm_link_static) {
    _ldflags_args += [ "--link-static" ]
  }
  _ldflags_args += [ "ldflags" ]
  llvm_ldflags = exec_script("//build/scripts/llvm_config.py",
                              _ldflags_args,
                              "list lines")

  _syslibs_args = [ llvm_config_bin ]
  if (llvm_link_static) {
    _syslibs_args += [ "--link-static" ]
  }
  _syslibs_args += [ "systemlibs" ]
  llvm_ldflags += exec_script("//build/scripts/llvm_config.py",
                               _syslibs_args,
                               "list lines")

  # When statically linking LLVM on Windows, llvm-config --link-static
  # --system-libs returns nothing because the MSYS2 LLVM package is a
  # shared-library build whose .dll already embeds these.  Supply the
  # transitive system deps of libLLVMSupport explicitly.  They must go
  # into libs (not ldflags) so they appear after the .a archives in the
  # link command — static linking resolves left-to-right.
  _extra_llvm_libs = []
  if (llvm_link_static && host_os == "win") {
    llvm_ldflags += [
      "-lzstd",
      "-lz",
      "-lole32",
      "-lshell32",
      "-luuid",
      "-loleaut32",
    ]
    _extra_llvm_libs += [
      "ntdll",
      "ole32",
      "shell32",
      "uuid",
      "oleaut32",
      "zstd",
      "z",
    ]
  }
  _libs_args = [ llvm_config_bin ]
  if (llvm_link_static) {
    _libs_args += [ "--link-static" ]
  }
  _libs_args += [ "libs" ]
  llvm_libs = exec_script("//build/scripts/llvm_config.py",
                          _libs_args,
                          "list lines") + _extra_llvm_libs
}
