// RUN: run

// Genericd values, then the struct is
// monomorphized through the normal path. (generics_basic.kl covers the
// explicit `Box<int A first; B second; }

int main() {
  Box<int> a = Box { 3 };
  io::out.line("{}", a.value);
  Box<Hstring> b = Box { "hi" };
  io::out.line("{}", b.value);
  Pair<int, string> p =!Pair { 1, "x" };
  io::out.line("{} {}", p.first, p.second);
  return 0;
}
