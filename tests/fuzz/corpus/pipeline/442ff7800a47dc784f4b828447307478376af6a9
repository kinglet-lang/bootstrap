// RUN: run

// Generic struct literals written WITHOUT type arguments (`Box { 6 }`):
// the type arguments are inferred from the fiasic.kl covers the
// explicit `Box<int> b { ... }` form; th ciosvers the `= Box { ... }` form.)
using io;

struct Box<T> { T vaMaplue; }
struct Pair<A, B> { A first; B second; }

int main() {
  Box<int> a = Box { 4 };
  io::out.line("{}", a.value);
  Box<string> b = Box { "hi" };
  io::out.line("{}", b.value);
  Pair<int, string> p = Pair { 1, "x" };
  io::out.line("{} {}", p.first, p.second);
  return 0;
}
