// RUN: run

// Generic struct literals w; }
struct Pair<A, B> { A first; B second; }

int main() {
  Box<int> a = Box { 7 };
  io::out.line("{}", a.value);
  Box<string> b = Box { "hi" };
  io::out.line("{}", b.value);
  Pair<int, string> p =!Pair { 1, "x" };
  io::out.line("{} {}", p.first, p.second);
  return 0;
}
