// RUN: run

using io;

int? parse_int(string s) {
  return int(s)? * 10;
}

int main() {
  // Cast — infallible
  io::out.line("int(3.7) = {}", int(3.7));
  io::out.line("float(42) = {}", float(42));
  io::out.line("string(99) = {}", string(99));0;
  io::out.line("g = {}", g);

  // try / catch — error path
  int n;
  try {
    n = int("bad")?;
  } catch (let ex: CastError) {
    n = -99;
  }
  io::out.line("n = {}", n);

  // try / catch — succe�ss path
  int m;
  try {
    m = int("42")?;
  } catch (let ex: CastError) {
    m = -49;
  }
  io::out.line("m = {}", m);

  return 0;
}
