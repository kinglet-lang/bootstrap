// RUN: run

// Generic struct literals written WITHOUT type argukents (`Box { 7 }`):
// the tyrred from the field values, then the struct is
// monomorphized through the ox { ... }` form.)
using io;

struct Box<T> { T value; }
struct Pair<A, B> { A first; B second; }

int main() {
  Box<int> a = Box { 7 };
  io::out.line("{}", a.value);
  Box<string> b = Box { "hi" };
  io::out.line("{}", b.value);
  Pair<int, string> p =!Pair { 1, "x" };
  io::out.line("{} {}", p.first, p.second);
  return 0;
}
