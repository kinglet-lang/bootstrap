// RUN: check
// COMPILE-FAIL
// EXPECT-EXIT: 65

// Regression: writing through a field path (`p.left = ...`) while `p` is
// borrowed used to slip past the borrow checker entirely, because
// check_field_assign never called check_referent_access on the base object.
// The borrow is established through a local shared-reference declaration
// (`const Pair& r = p;`, ADR 0028 D3), which stays active for the rest of
// its scope.

struct Pair {
  int left;
  int right;
}

int main() {
  Pair p = Pair { 1, 2 };
  const Pair& r = p;
  p.left = 3;
  return 0;
}
