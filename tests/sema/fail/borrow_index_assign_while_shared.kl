// RUN: check
// COMPILE-FAIL
// EXPECT-EXIT: 65

// Regression: writing through an index path (`arr[i] = ...`) while `arr` is
// borrowed used to slip past the borrow checker entirely, because
// check_index_assign never called check_referent_access on the base object.
// The borrow is established through a local shared-reference declaration
// (`const int[]& r = arr;`, ADR 0028 D3), which stays active for the rest
// of its scope.

int main() {
  int[] arr = [1, 2, 3];
  const int[]& r = arr;
  arr[0] = 9;
  return 0;
}
