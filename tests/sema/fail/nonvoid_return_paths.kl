int missing_else(bool cond) {
  if cond {
    return 1;
  }
}

auto inferred_missing(bool cond) {
  if cond {
    return 2;
  }
}

T generic_missing<T>(bool cond, T value) {
  if cond {
    return value;
  }
}

int wrong_implicit_return() {
  "not an int";
}
