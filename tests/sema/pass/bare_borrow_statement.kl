// RUN: check
// EXPECT-EXIT: 0

// A bare `&expr;` as its own statement (not inside a call argument or a
// declaration initializer) must parse as an explicit borrow marker (ADR
// 0028 D3). With no target-type context, it defaults to a shared borrow,
// which imposes no exclusivity restriction here.

int main() {
  int a = 1;
  &a;

  int b = 2;
  &b;
  return 0;
}
