// EXPECT_OUT: ok
// ADR 0028: exclusive borrow (T&) on struct scalar field with auto-deref
// through parameter.
using io;

struct Box {
  int v;
}

void bump(int& x) {
  x = x + 1;
}

int main() {
  Box b = Box { 1 };
  bump(b.v);
  if (b.v != 2) {
    return 1;
  }
  io::out.line("ok");
  return 0;
}
