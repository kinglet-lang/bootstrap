// RUN: run

using io;

int main() {
  // An Optional declared without an initializer defaults to null.
  int? a;
  if a == null {
    io::out("a is null\n");
  }

  int? b = 42;
  if b != null {
    io::out("b has value\n");
  }

  // Default null flows through ?: just like an explicit null.
  io::out("{}\n", a ?: -1);
  return 0;
}
