// RUN: run
// EXPECT-EXIT: 0

// Regression: structs with @destroy must still compile and run with
// the scope-exit Drop infrastructure. The Drop instruction calls the
// @destroy function before the Return instruction.

struct Holder {
  int value;

  @destroy { }
}

int main() {
  Holder h = Holder { 42 };
  return 0;
}
