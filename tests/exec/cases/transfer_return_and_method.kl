// RUN: run
// CHECK: t: 42
// CHECK: destroy 42
// CHECK: v: 7
// CHECK: destroy 7

using io;

struct Tag {
  int id;
  @destroy {
    io::out("destroy {}\n", self.id);
  }
}

// Issue 3: return a resource local by identifier
Tag make() {
  Tag a { 42 };
  return a;  // a is transferred to caller, not destroyed here
}

// Issue 4: method-call receiver passed by value
int consume(Tag self) {
  return self.id;
}

int main() {
  Tag t = make();
  io::out("t: {}\n", t.id);

  Tag b { 7 };
  int v = b.consume();
  io::out("v: {}\n", v);

  return 0;
  // Expected: destroy 7 (b consumed via method call), destroy 42 (t)
}
