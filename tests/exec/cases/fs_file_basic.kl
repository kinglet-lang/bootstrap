// RUN: run
// CHECK: 16
// CHECK: 1
// CHECK: 0
// CHECK: 16
// CHECK: 72

using io;
using fs;

int main() {
  // Create a test file using fs::file directly.
  fs::file seed = fs::create("/tmp/kinglet_fs_file_test.txt");
  byte[] hello = [byte(72), byte(101), byte(108), byte(108), byte(111), byte(44),
                  byte(32), byte(102), byte(115), byte(58), byte(58), byte(102),
                  byte(105), byte(108), byte(101), byte(33)];
  seed.write(hello);
  seed.sync();
  seed.close();

  // D2: fs::open(path) -> fs::file
  fs::file input = fs::open("/tmp/kinglet_fs_file_test.txt");

  // D1: file.size() -> u64
  int sz = input.size();
  io::out.line("{}", sz);

  // D1: file.open() -> bool (handle is open before close)
  io::out.line("{}", input.open());

  // D1: file.close()
  input.close();

  // D2: fs::create(path) -> fs::file (write mode)
  fs::file output = fs::create("/tmp/kinglet_fs_file_test2.txt");

  // D1: file.close()
  output.close();

  // D1: file.open() -> bool (handle is closed)
  io::out.line("{}", output.open());

  // Verify content using fs::read byte[] API.
  byte[] content = fs::read("/tmp/kinglet_fs_file_test.txt");
  io::out.line("{}", content.len());
  io::out.line("{}", content[0]);

  return 0;
}
