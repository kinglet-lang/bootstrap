// RUN: run
// RUN-ARGS: $HARNESS_TMP
// CHECK: 5
// CHECK: 5
// CHECK: 87
// CHECK: 1

using io;
using fs;
using sys;

// Generic function accepting io::reader.
// fs::file satisfies io::reader because it has read(byte[]).
int read_all(io::reader input) {
  byte[] buffer;
  buffer.resize(16, byte(0));
  uint64 n = input.read(buffer);
  io::out.line("{}", n);
  return 0;
}

// Generic function accepting io::writer.
// Passing fs::file by value transfers ownership to this function.
int emit(io::writer output, byte[] data) {
  output.write(data);
  return 0;
}

int main() {
  string[] args = sys::args();
  string tmp = args[0];
  string reader_path = tmp + "/kinglet_concept_test.txt";
  string writer_path = tmp + "/kinglet_concept_write.txt";
  string concept_writer_path = tmp + "/kinglet_concept_writer_concept.txt";

  byte[] data;
  data.resize(5, byte(0));
  data[0] = byte(87);  // W
  data[1] = byte(111); // o
  data[2] = byte(114); // r
  data[3] = byte(108); // l
  data[4] = byte(100); // d

  // Write a file, then read it through io::reader.
  fs::file rf_seed = fs::create(reader_path);
  rf_seed.write(data);
  rf_seed.sync();
  rf_seed.close();
  read_all(fs::open(reader_path));

  // Write a file through the concrete fs::file interface.
  fs::file wf = fs::create(writer_path);
  wf.write(data);
  wf.sync();
  wf.close();

  byte[] content = fs::read(writer_path);
  io::out.line("{}", content.len());
  io::out.line("{}", content[0]);

  // Confirm that fs::file also satisfies io::writer.
  emit(fs::create(concept_writer_path), data);

  fs::file f = fs::open(reader_path);
  io::out.line("{}", f.open());

  return 0;
}
