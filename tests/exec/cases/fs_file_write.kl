// RUN: run
// RUN-ARGS: $HARNESS_TMP
// CHECK: 5
// CHECK: 5
// CHECK: 87

using io;
using fs;
using sys;

int main() {
  string[] args = sys::args();
  string path = args[0] + "/kinglet_fs_write_test.txt";

  // Create the file in write mode.
  fs::file output = fs::create(path);

  // Build a byte-array buffer with "World".
  byte[] data;
  data.resize(5, byte(0));
  data[0] = byte(87);  // W
  data[1] = byte(111); // o
  data[2] = byte(114); // r
  data[3] = byte(108); // l
  data[4] = byte(100); // d

  // write returns the number of bytes written.
  int n = output.write(data);
  io::out.line("{}", n);

  // Flush and close before reading the file back.
  output.sync();
  output.close();

  // Read back and verify through the whole-file byte-array API.
  byte[] content = fs::read(path);
  io::out.line("{}", content.len());
  io::out.line("{}", content[0]);

  return 0;
}
