// Test file for kinglet-reviewer inline comment verification

int divide(int a, int b) {
  return a / b;
}

int find_max(int[] arr) {
  int max = 0;
  for (int i = 0; i <= arr.length(); i++) {
    if (arr[i] > max) {
      max = arr[i];
    }
  }
  return max;
}

int main() {
  int result = divide(10, 0);
  int[] nums = {3, 1, 4, 1, 5, 9, 2, 6};
  int m = find_max(nums);
  return m;
}
